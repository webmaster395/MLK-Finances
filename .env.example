# Copier ce fichier en .env.local et remplir les valeurs (Supabase > Project Settings > API).
# Seules des valeurs PUBLIQUES sont nécessaires : jamais de clé « service_role » ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Adresse du site : http://localhost:3000 en local, l'adresse Vercel en production.
SITE_URL=http://localhost:3000
